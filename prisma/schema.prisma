generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

enum VehicleType {
  TRACTOR
  TRUCK
  TRAILER
  DRY_VAN
  PLATFORM
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  IN_ROUTE
  MAINTENANCE
  INACTIVE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions             Session[]
  createdFleetExpenses FleetExpense[] @relation("FleetExpenseCreatedBy")
  paidFleetExpenses    FleetExpense[] @relation("FleetExpensePaidBy")
  createdTrips         Trip[]         @relation("TripCreatedBy")
  updatedTrips         Trip[]         @relation("TripUpdatedBy")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Driver {
  id String @id @default(cuid())

  name             String
  phone            String?
  licenseNumber    String?
  licenseType      String?
  licenseExpiresAt DateTime?
  status           DriverStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
  trips    Trip[]

  @@index([status])
}

model Vehicle {
  id String @id @default(cuid())

  economicNumber String @unique

  type  VehicleType
  brand String
  model String
  year  Int
  color String?

  plate String? @unique
  vin   String? @unique

  status    VehicleStatus @default(AVAILABLE)
  location  String?
  mileage   Int           @default(0)
  fuelLevel Int           @default(0)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  lastServiceAt DateTime?
  nextServiceAt DateTime?

  insuranceStatus    String?
  registrationStatus String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  fleetExpenses FleetExpense[]
  trips         Trip[]

  @@index([status])
  @@index([driverId])
  @@index([type])
}

enum ExpenseCategory {
  FUEL
  TOLLS
  PER_DIEM
  PARTS
  MAINTENANCE
  WASH
  TIRES
  OTHER
}

enum FleetExpenseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ExpenseSource {
  MANUAL
  WHATSAPP
  IMPORT
  API
}

enum PaymentStatus {
  PENDING
  PAID
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  taxId     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fleetExpenses FleetExpense[]

  @@index([active, name])
  @@index([taxId])
}

model FleetExpense {
  id               String             @id @default(cuid())
  vehicleId        String
  createdById      String
  supplierId       String?
  tripId           String?
  expenseDate      DateTime           @default(now()) @db.Date
  category         ExpenseCategory
  description      String
  subtotal         Decimal            @db.Decimal(12, 2)
  laborAmount      Decimal            @default(0) @db.Decimal(12, 2)
  total            Decimal            @db.Decimal(12, 2)
  mileage          Int?
  receiptNumber    String?
  notes            String?
  status           FleetExpenseStatus @default(CONFIRMED)
  source           ExpenseSource      @default(MANUAL)
  paymentStatus    PaymentStatus      @default(PENDING)
  paidAt           DateTime?
  paidByUserId     String?
  paymentMethod    String?
  paymentReference String?
  paymentNotes     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy User          @relation("FleetExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  supplier  Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  trip      Trip?         @relation(fields: [tripId], references: [id], onDelete: Restrict)
  paidBy    User?         @relation("FleetExpensePaidBy", fields: [paidByUserId], references: [id], onDelete: Restrict)
  items     ExpenseItem[]

  @@index([vehicleId, expenseDate])
  @@index([category, expenseDate])
  @@index([supplierId, expenseDate])
  @@index([status, expenseDate])
  @@index([paymentStatus, expenseDate])
  @@index([createdById, expenseDate])
  @@index([paidByUserId])
  @@index([tripId, expenseDate])
}

model ExpenseItem {
  id             String   @id @default(cuid())
  fleetExpenseId String
  description    String
  unit           String?
  quantity       Decimal  @db.Decimal(10, 3)
  unitCost       Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fleetExpense FleetExpense @relation(fields: [fleetExpenseId], references: [id], onDelete: Cascade)

  @@index([fleetExpenseId])
}

model Client {
  id             String   @id @default(cuid())
  businessName   String
  commercialName String?
  taxId          String?  @unique
  contactName    String?
  phone          String?
  email          String?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  addresses ClientAddress[]
  trips     Trip[]

  @@index([active, businessName])
  @@index([commercialName])
}

model ClientAddress {
  id             String   @id @default(cuid())
  clientId       String
  name           String
  street         String
  exteriorNumber String?
  interiorNumber String?
  neighborhood   String?
  city           String
  state          String
  postalCode     String?
  country        String   @default("México")
  reference      String?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  trips  Trip[]

  @@unique([clientId, name])
  @@index([clientId, active])
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Trip {
  id                      String     @id @default(cuid())
  tripNumber              String     @unique
  status                  TripStatus @default(SCHEDULED)
  clientId                String
  destinationAddressId    String
  clientNameSnapshot      String
  destinationNameSnapshot String
  destinationSnapshot     String
  origin                  String
  vehicleId               String
  driverId                String
  scheduledStartAt        DateTime
  startedAt               DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  mileageStart            Int
  mileageEnd              Int?
  revenue                 Decimal    @db.Decimal(12, 2)
  notes                   String?
  createdById             String
  updatedById             String
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  client      Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  destination ClientAddress  @relation(fields: [destinationAddressId], references: [id], onDelete: Restrict)
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver      Driver         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  createdBy   User           @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User           @relation("TripUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  expenses    FleetExpense[]

  @@index([clientId, scheduledStartAt])
  @@index([destinationAddressId])
  @@index([vehicleId, scheduledStartAt])
  @@index([driverId, scheduledStartAt])
  @@index([status, scheduledStartAt])
}
