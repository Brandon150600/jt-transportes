generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

enum NotificationType {
  TRIP_CREATED
  TRIP_SUBCONTRACTED_CREATED
  TRIP_UPCOMING
  TRIP_STARTED
  TRIP_COMPLETED
  TRIP_CANCELLED
  TRIP_CUSTOMER_PAYMENT_RECEIVED
  TRIP_SUBCONTRACTOR_PAYMENT_COMPLETED
  EXPENSE_CREATED
  VEHICLE_MAINTENANCE_DUE
}

enum NotificationEntityType {
  TRIP
  FLEET_EXPENSE
  VEHICLE
}

enum VehicleType {
  TRACTOR
  TRUCK
  TRAILER
  DRY_VAN
  PLATFORM
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  IN_ROUTE
  MAINTENANCE
  INACTIVE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions               Session[]
  notificationReads      NotificationRead[]
  createdFleetExpenses   FleetExpense[]     @relation("FleetExpenseCreatedBy")
  paidFleetExpenses      FleetExpense[]     @relation("FleetExpensePaidBy")
  createdTrips           Trip[]             @relation("TripCreatedBy")
  updatedTrips           Trip[]             @relation("TripUpdatedBy")
  customerPaidTrips      Trip[]             @relation("TripCustomerPaidBy")
  subcontractorPaidTrips Trip[]             @relation("TripSubcontractorPaidBy")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id         String                  @id @default(cuid())
  eventKey   String                  @unique
  type       NotificationType
  title      String
  message    String
  entityType NotificationEntityType?
  entityId   String?
  createdAt  DateTime                @default(now())

  reads NotificationRead[]

  @@index([createdAt, id])
}

model NotificationRead {
  userId         String
  notificationId String
  readAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([userId, notificationId])
  @@index([notificationId])
}

model Driver {
  id String @id @default(cuid())

  name             String
  phone            String?
  licenseNumber    String?
  licenseType      String?
  licenseExpiresAt DateTime?
  status           DriverStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
  trips    Trip[]

  @@index([status])
}

model Vehicle {
  id String @id @default(cuid())

  economicNumber String @unique

  type  VehicleType
  brand String
  model String
  year  Int
  color String?

  plate String? @unique
  vin   String? @unique

  status    VehicleStatus @default(AVAILABLE)
  location  String?
  mileage   Int           @default(0)
  fuelLevel Int           @default(0)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  lastServiceAt DateTime?
  nextServiceAt DateTime?

  insuranceStatus    String?
  registrationStatus String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  fleetExpenses FleetExpense[]
  trips         Trip[]

  @@index([status])
  @@index([driverId])
  @@index([type])
}

enum ExpenseCategory {
  FUEL
  TOLLS
  PER_DIEM
  PARTS
  MAINTENANCE
  WASH
  TIRES
  OTHER
}

enum FleetExpenseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ExpenseSource {
  MANUAL
  WHATSAPP
  IMPORT
  API
}

enum PaymentStatus {
  PENDING
  PAID
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  taxId     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fleetExpenses FleetExpense[]

  @@index([active, name])
  @@index([taxId])
}

model FleetExpense {
  id               String             @id @default(cuid())
  vehicleId        String
  createdById      String
  supplierId       String?
  tripId           String?
  expenseDate      DateTime           @default(now()) @db.Date
  category         ExpenseCategory
  description      String
  subtotal         Decimal            @db.Decimal(12, 2)
  laborAmount      Decimal            @default(0) @db.Decimal(12, 2)
  total            Decimal            @db.Decimal(12, 2)
  mileage          Int?
  receiptNumber    String?
  notes            String?
  status           FleetExpenseStatus @default(CONFIRMED)
  source           ExpenseSource      @default(MANUAL)
  paymentStatus    PaymentStatus      @default(PENDING)
  paidAt           DateTime?
  paidByUserId     String?
  paymentMethod    String?
  paymentReference String?
  paymentNotes     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy User          @relation("FleetExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  supplier  Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  trip      Trip?         @relation(fields: [tripId], references: [id], onDelete: Restrict)
  paidBy    User?         @relation("FleetExpensePaidBy", fields: [paidByUserId], references: [id], onDelete: Restrict)
  items     ExpenseItem[]

  @@index([vehicleId, expenseDate])
  @@index([category, expenseDate])
  @@index([supplierId, expenseDate])
  @@index([status, expenseDate])
  @@index([paymentStatus, expenseDate])
  @@index([createdById, expenseDate])
  @@index([paidByUserId])
  @@index([tripId, expenseDate])
}

model ExpenseItem {
  id             String   @id @default(cuid())
  fleetExpenseId String
  description    String
  unit           String?
  quantity       Decimal  @db.Decimal(10, 3)
  unitCost       Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fleetExpense FleetExpense @relation(fields: [fleetExpenseId], references: [id], onDelete: Cascade)

  @@index([fleetExpenseId])
}

model Client {
  id             String   @id @default(cuid())
  businessName   String
  commercialName String?
  taxId          String?  @unique
  contactName    String?
  phone          String?
  email          String?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  addresses ClientAddress[]
  trips     Trip[]

  @@index([active, businessName])
  @@index([commercialName])
}

model ClientAddress {
  id             String   @id @default(cuid())
  clientId       String
  name           String
  street         String
  exteriorNumber String?
  interiorNumber String?
  neighborhood   String?
  city           String
  state          String
  postalCode     String?
  country        String   @default("México")
  reference      String?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  trips  Trip[]

  @@unique([clientId, name])
  @@index([clientId, active])
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripExecutionType {
  OWN
  SUBCONTRACTED
}

model ExternalCarrier {
  id           String   @id @default(cuid())
  businessName String
  contactName  String?
  phone        String?
  email        String?
  taxId        String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips Trip[]

  @@index([active, businessName])
  @@index([taxId])
}

model Trip {
  id                          String            @id @default(cuid())
  tripNumber                  String            @unique
  status                      TripStatus        @default(SCHEDULED)
  executionType               TripExecutionType @default(OWN)
  clientId                    String
  destinationAddressId        String
  clientNameSnapshot          String
  destinationNameSnapshot     String
  destinationSnapshot         String
  origin                      String
  vehicleId                   String?
  driverId                    String?
  externalCarrierId           String?
  externalCarrierNameSnapshot String?
  externalVehicleDescription  String?
  externalDriverName          String?
  scheduledStartAt            DateTime
  startedAt                   DateTime?
  completedAt                 DateTime?
  cancelledAt                 DateTime?
  mileageStart                Int?
  mileageEnd                  Int?
  revenue                     Decimal           @db.Decimal(12, 2)
  subcontractorCost           Decimal?          @db.Decimal(12, 2)
  customerPaymentStatus       PaymentStatus?
  customerPaidAt              DateTime?
  customerPaidByUserId        String?
  subcontractorPaymentStatus  PaymentStatus?
  subcontractorPaidAt         DateTime?
  subcontractorPaidByUserId   String?
  notes                       String?
  createdById                 String
  updatedById                 String
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  client              Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  destination         ClientAddress    @relation(fields: [destinationAddressId], references: [id], onDelete: Restrict)
  vehicle             Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver              Driver?          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  externalCarrier     ExternalCarrier? @relation(fields: [externalCarrierId], references: [id], onDelete: Restrict)
  customerPaidBy      User?            @relation("TripCustomerPaidBy", fields: [customerPaidByUserId], references: [id], onDelete: Restrict)
  subcontractorPaidBy User?            @relation("TripSubcontractorPaidBy", fields: [subcontractorPaidByUserId], references: [id], onDelete: Restrict)
  createdBy           User             @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           User             @relation("TripUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  expenses            FleetExpense[]

  @@index([clientId, scheduledStartAt])
  @@index([destinationAddressId])
  @@index([vehicleId, scheduledStartAt])
  @@index([driverId, scheduledStartAt])
  @@index([status, scheduledStartAt])
  @@index([executionType, status, scheduledStartAt])
  @@index([clientId, executionType, customerPaymentStatus, scheduledStartAt])
  @@index([externalCarrierId, subcontractorPaymentStatus, scheduledStartAt])
}
